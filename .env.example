# =============================================================================
# Learning Study AI — Environment Variables (TDD §10)
#
# Salin file ini menjadi `.env`, lalu isi nilainya:
#   cp .env.example .env
#
# Startup aplikasi memvalidasi seluruh variable lewat Zod (src/server/env.ts) dan
# GAGAL CEPAT bila yang wajib kosong — termasuk aturan bersyarat STORAGE_DRIVER.
# Legenda: [WAJIB] harus diisi · [OPSIONAL] punya default di src/server/env.ts
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# [WAJIB] development | test | production
NODE_ENV=development
# [WAJIB] Base URL absolut — dipakai cookie, redirect, dan URL media
APP_BASE_URL=http://localhost:3000

# --- Database ----------------------------------------------------------------
# [WAJIB] Koneksi PostgreSQL 16.
# Di platform serverless (Vercel) WAJIB memakai connection string ber-pooler
# dari penyedia database, dan turunkan DATABASE_POOL_MAX ke 5.
DATABASE_URL=postgres://app:password@localhost:5432/learning_study_ai
# [OPSIONAL] Batas koneksi aplikasi (default 10). Serverless: 5
DATABASE_POOL_MAX=10

# --- Session & Password (TDD §5.1) -------------------------------------------
# [OPSIONAL] Nama cookie sesi (default lsai_session)
SESSION_COOKIE_NAME=lsai_session
# [OPSIONAL] Umur sesi normal, detik (default 28800 = 8 jam)
SESSION_TTL_SECONDS=28800
# [OPSIONAL] Umur sesi "Remember me", detik (default 2592000 = 30 hari)
SESSION_REMEMBER_TTL_SECONDS=2592000
# [WAJIB] Signing cookie & CSRF token. Minimal 32 karakter.
# Generate: openssl rand -base64 32
SESSION_SECRET=ganti-dengan-random-32-byte-yang-aman-xxxxx
# [OPSIONAL] Parameter Argon2id, KiB (default 19456 = OWASP minimum 19 MiB)
ARGON2_MEMORY_KIB=19456

# --- Media Storage (TDD §8.1) ------------------------------------------------
# [WAJIB] blob = Vercel Blob · local = volume disk
# Catatan: filesystem di Vercel bersifat ephemeral — di sana WAJIB pakai `blob`.
STORAGE_DRIVER=local
# [WAJIB bila STORAGE_DRIVER=blob] Kredensial Vercel Blob
BLOB_READ_WRITE_TOKEN=
# [WAJIB bila STORAGE_DRIVER=local] Direktori media (harus volume persisten)
LOCAL_STORAGE_DIR=./storage/uploads
# [WAJIB] Host media untuk whitelist img-src CSP & sanitasi src (TDD §8.4)
MEDIA_PUBLIC_HOST=http://localhost:3000
# [OPSIONAL] Batas ukuran cover event, byte (default 3145728 = 3 MB)
UPLOAD_MAX_COVER_BYTES=3145728
# [OPSIONAL] Batas ukuran gambar materi, byte (default 2097152 = 2 MB)
UPLOAD_MAX_IMAGE_BYTES=2097152

# --- Perilaku Aplikasi -------------------------------------------------------
# [OPSIONAL] Batas submit respons per menit per peserta (default 10, PRD §7.2)
RATE_LIMIT_RESPONSE_PER_MINUTE=10
# [OPSIONAL] TTL cache agregat dashboard, detik (default 30, TDD §7.3)
DASHBOARD_CACHE_TTL_SECONDS=30
# [OPSIONAL] Ambang klasifikasi peserta "Stalled", hari (default 3, TDD §7.5)
STALLED_THRESHOLD_DAYS=3

# --- Bootstrap Admin Pertama (dipakai `npm run db:seed`) ---------------------
# [WAJIB saat deploy awal] Admin pertama. Password DI-HASH Argon2id oleh seed —
# tidak pernah disimpan plaintext (PRD §7.8).
SEED_ADMIN_EMAIL=admin@learningstudy.ai
SEED_ADMIN_PASSWORD=Admin12345
# [OPSIONAL] Nama & no. HP admin pertama
SEED_ADMIN_NAME=Admin Learning Study
SEED_ADMIN_PHONE=+628123456789

# --- Observability -----------------------------------------------------------
# [OPSIONAL] fatal | error | warn | info | debug | trace (default info)
LOG_LEVEL=info
# [OPSIONAL] Error tracking Sentry — kosongkan bila tidak dipakai
SENTRY_DSN=
