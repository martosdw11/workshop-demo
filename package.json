    "@vercel/blob": "^2.8.0",
    "drizzle-orm": "^0.45.2",
    "next": "15.5.23",
    "pino": "^10.3.1",
    "postgres": "^3.4.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sanitize-html": "^2.17.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/typography": "^0.5.16",
