    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.23",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^3.4.17",
