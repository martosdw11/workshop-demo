    "db:seed:bulk": "tsx src/server/db/seed-bulk.ts",
    "db:reset": "tsx src/server/db/reset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@tiptap/extension-image": "^3.30.0",
    "@tiptap/html": "^3.30.0",
